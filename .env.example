# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/taskflow_db

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379
QUEUE_PORT=32856

# Brevo (Sendinblue) Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_NAME=TaskFlow
BREVO_FROM_EMAIL=no-reply@taskflow.com

# JWT Secrets & Expirations
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Rate Limiting
BCRYPT_SALT_ROUNDS=12
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
REGISTRATION_TTL_SECONDS=120
